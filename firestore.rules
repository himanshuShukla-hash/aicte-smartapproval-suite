rules_version = '2';

/**
 * AICTE SmartApproval Suite - Firestore Security Rules
 * Specification: PRD v2.0 Section 11 - Security and API Enforcement
 * 
 * CORE PRINCIPLE: "Firebase provides infrastructure; the SmartApproval Suite backend enforces rules."
 * - Deny-by-default
 * - Restrict institution data by ownership
 * - Restrict reviewer access by assignment
 * - Deny direct client writes to decisions, workflowEvents, auditEvents, and published rules
 */

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper Functions
    function isSignedIn() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(role) {
      return isSignedIn() && getUserData().role == role && getUserData().active == true;
    }

    function isAdmin() {
      return hasRole('admin');
    }

    function isReviewer() {
      return hasRole('reviewer');
    }

    function isInstitution() {
      return hasRole('institution');
    }

    function isInstitutionOwner(instId) {
      return isInstitution() && getUserData().institutionId == instId;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // 7.1 users/{uid}
    match /users/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin() || isReviewer());
      // Self-promotion blocked: Only trusted Cloud Functions or Admin can write roles
      allow write: if isAdmin();
    }

    // 7.2 institutions/{institutionId}
    match /institutions/{institutionId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || (isInstitutionOwner(institutionId) && request.resource.data.status == resource.data.status);
    }

    // 7.3 applications/{applicationId}
    match /applications/{applicationId} {
      allow read: if isSignedIn() && (
        isAdmin() || 
        isReviewer() || 
        isInstitutionOwner(resource.data.institutionId)
      );
      
      // Institutions can only update drafts before submission
      allow update: if isSignedIn() && 
        isInstitutionOwner(resource.data.institutionId) &&
        resource.data.status == 'draft' &&
        // Cannot alter status, currentStage, or assignedReviewer directly
        request.resource.data.status == resource.data.status &&
        request.resource.data.currentStage == resource.data.currentStage &&
        request.resource.data.assignedReviewerId == resource.data.assignedReviewerId;

      // Status changes and privileged transitions MUST go through Cloud Functions
      allow create, delete: if false;

      // Subcollection: 7.4 documents
      match /documents/{documentId} {
        allow read: if isSignedIn() && (
          isAdmin() || 
          isReviewer() || 
          isInstitutionOwner(get(/databases/$(database)/documents/applications/$(applicationId)).data.institutionId)
        );
        allow write: if false; // Registered via registerDocument Cloud Function
      }
    }

    // 7.5 complianceEvaluations/{evaluationId}
    match /complianceEvaluations/{evaluationId} {
      allow read: if isSignedIn();
      allow write: if false; // Server-only calculation via evaluateCompliance Cloud Function
    }

    // 7.6 deficiencies/{deficiencyId}
    match /deficiencies/{deficiencyId} {
      allow read: if isSignedIn();
      allow write: if false; // Server-only via createDeficiency/respondToDeficiency/resolveDeficiency
    }

    // 7.7 workflowEvents/{eventId}
    match /workflowEvents/{eventId} {
      allow read: if isSignedIn() && (isAdmin() || isReviewer() || isInstitution());
      allow write: if false; // Append-only generated by backend Cloud Functions
    }

    // 7.8 auditEvents/{eventId}
    match /auditEvents/{eventId} {
      allow read: if isAdmin();
      allow write: if false; // Strictly append-only generated by server
    }

    // 7.9 notifications/{notificationId}
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && resource.data.recipientUid == request.auth.uid;
      allow update: if isSignedIn() && resource.data.recipientUid == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt', 'deliveryStatus']);
      allow create, delete: if false;
    }

    // 7.10 complianceRules/{ruleId}
    match /complianceRules/{ruleId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
